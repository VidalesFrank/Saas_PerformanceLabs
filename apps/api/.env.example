# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./performancelabs.db

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Redis / Celery (tasks del Constructor de Modelos) ────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Almacenamiento de archivos ────────────────────────────────────────────────
# Directorio raíz de datos compartido entre la API (Windows) y el worker (Docker)
BASE_DATA_DIR=./data

# ── Pasos para activar el pipeline no lineal (pushover/NLTH/IDA) ─────────────
# 1. Docker Desktop corriendo
# 2. Copia los 44 registros FEMA P-695 → apps/api/data/records/fema_records/*.txt
# 3. docker compose up -d
# 4. docker compose logs celery-worker
