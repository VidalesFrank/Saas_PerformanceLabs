# ── Copiar a .env y completar los valores ─────────────────────────────────────
# cp .env.example .env

# ── Base de datos PostgreSQL ───────────────────────────────────────────────────
POSTGRES_USER=plabs
POSTGRES_PASSWORD=cambia_esta_clave_segura

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia_este_secreto_jwt_muy_largo

# ── Servidor ───────────────────────────────────────────────────────────────────
# Hostname o IP del servidor (para CORS). En local no hace falta cambiarlo.
SERVER_HOST=localhost
